  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:fees && npm run test:calc && npm run test:access && npm run test:auth && npm run test:demo && npm run test:cache && npm run test:ui && npm run test:gallery && npm run test:analytics && npm run test:perf && npm run test:sql",
    "test:fees": "node --experimental-strip-types --no-warnings scripts/fee-check.mts",
    "test:calc": "node --experimental-strip-types --no-warnings scripts/calc-check.mts",
    "test:access": "node --experimental-strip-types --no-warnings scripts/admin-check.mts",
    "test:auth": "node --experimental-strip-types --no-warnings scripts/auth-check.mts",
    "test:demo": "node --experimental-strip-types --no-warnings scripts/demo-check.mts",
    "test:cache": "node --experimental-strip-types --no-warnings scripts/cache-check.mts",
    "test:ui": "node --experimental-strip-types --no-warnings scripts/picker-check.mts",
    "test:gallery": "node --experimental-strip-types --no-warnings scripts/gallery-check.mts",
    "test:analytics": "node --experimental-strip-types --no-warnings scripts/analytics-check.mts",
    "test:perf": "node --experimental-strip-types --no-warnings scripts/perf-check.mts",
    "test:sql": "node scripts/sql-check.mjs",
